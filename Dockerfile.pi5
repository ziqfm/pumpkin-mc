FROM --platform=$BUILDPLATFORM docker.io/tonistiigi/xx AS xx

FROM --platform=$BUILDPLATFORM rust:1-alpine AS builder

ARG LLVM_VERSION=23

# Copy the xx scripts into our builder
COPY --from=xx / /

# Install native LLVM 21 components
RUN apk add --no-cache \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    clang${LLVM_VERSION} lld${LLVM_VERSION} curl jq pkgconf git ca-certificates \
    build-base bash

RUN ln -sf clang-${LLVM_VERSION} /usr/bin/clang \
 && ln -sf clang++-${LLVM_VERSION} /usr/bin/clang++

RUN curl --retry 5 -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall --no-confirm lddtree@0.5.0

WORKDIR /app
COPY . .

# Tell xx what we are building for (it will detect it matches the host and run natively)
ARG TARGETPLATFORM

# Let xx configure the Rust toolchain to properly separate host/target builds
RUN xx-cargo --setup-target-triple

# Tell xx to use Clang
ENV CC=clang-${LLVM_VERSION}
ENV CXX=clang++-${LLVM_VERSION}

# Extreme Cargo Optimizations
ENV CARGO_PROFILE_RELEASE_LTO="fat"
ENV CARGO_PROFILE_RELEASE_STRIP="symbols"
ENV CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

# The extreme flags. xx-cargo will shield serde/quote from these automatically!
ENV RUSTFLAGS="-C target-feature=-crt-static -Clinker-plugin-lto -C link-arg=-fuse-ld=lld -C target-cpu=cortex-a76"
ENV RUST_MIN_STACK=268435456

# Build the binary using the xx wrapper
RUN xx-cargo build --release --locked

# Isolate the binary, dynamically linked musl dependencies, and SSL certs
RUN <<'EOF'
set -e
CARGO_TERM_VERBOSE=true xx-cargo build --release --locked > /tmp/build.log 2>&1 \
  || { tail -n 80 /tmp/build.log; exit 1; }
awk '
/Running `.*rustc --crate-name / {
  match($0, /--crate-name [^ ]+/); name = substr($0, RSTART + 13, RLENGTH - 13)
  kind = (index($0, " --target ") ? "target" : "host")
  cgu = "default"; line = $0
  while (match(line, /codegen-units=[0-9]+/)) { cgu = substr(line, RSTART + 14, RLENGTH - 14); line = substr(line, RSTART + RLENGTH) }
  count[kind " cgu=" cgu]++
  if (kind == "target" && cgu != "1") bad[name] = cgu
}
END {
  print "codegen-units summary:"
  for (k in count) print "  " count[k] " " k " crates"
  n = 0; for (c in bad) { if (!n++) print "Target crates NOT at 1 codegen unit:"; print "  " c " (" bad[c] ")" }
  if (!n) print "All target crates compiled with codegen-units=1."
}' /tmp/build.log
EOF


FROM scratch

COPY --from=builder /out/libs-root/ /
COPY --from=builder /out/etc/ /etc/
COPY --from=builder /out/libs/ /usr/lib/
COPY --from=builder /out/sbin/ /sbin/

ENV LD_LIBRARY_PATH=/usr/lib
ENV RUST_BACKTRACE=1

EXPOSE 25565
WORKDIR /pumpkin
USER 1000:1000

CMD ["/sbin/pumpkin"]
